{
  "name": "@skilleddragon/minilab-cloudflare-agents-edge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkilledDragon minilab: cloudflare/agents pin + edge-agent least-privilege policy checklist",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit",
    "check:skills": "bun run scripts/check-skills.ts",
    "check:banned-phrases": "bun run scripts/check-banned-phrases.ts",
    "validate:policy": "bun run src/cli.ts fixtures/edge-agent-policy.json",
    "clone:upstream": "bash scripts/clone-upstream.sh",
    "upstream": "bash scripts/upstream-agents.sh",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  }
}
